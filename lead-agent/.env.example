# Groq API (agent loop)
GROQ_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Database — use Supabase Postgres in production (persistent storage)
# Supabase: Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
DATABASE_URL=

# Local dev / tests only — SQLite when DATABASE_URL is unset
DATABASE_PATH=leads.db
