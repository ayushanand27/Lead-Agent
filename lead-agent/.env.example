# Groq API (agent loop)
GROQ_API_KEY=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Database — use Supabase Postgres in production (persistent storage)
# Option A: full URI (URL-encode @ # etc. in password)
DATABASE_URL=
# Option B (recommended on Render): URI without password + plain password here
# DATABASE_URL=postgresql://postgres.PROJECT_REF@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_PASSWORD=

# Local dev / tests only — SQLite when DATABASE_URL is unset
DATABASE_PATH=leads.db
