# Groq API (agent loop + voice transcription)
GROQ_API_KEY=
# Optional — Groq Whisper model for WhatsApp voice notes (default: whisper-large-v3-turbo)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Database — use Supabase Postgres in production (persistent storage)
# Option A: full URI (URL-encode @ # etc. in password)
DATABASE_URL=
# Option B (recommended on Render): URI without password + plain password here
# DATABASE_URL=postgresql://postgres.PROJECT_REF@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_PASSWORD=

# Local dev / tests only — SQLite when DATABASE_URL is unset
DATABASE_PATH=leads.db

# Optional: DEBUG, INFO (default), WARNING
LOG_LEVEL=INFO

# Business branding (per-client deploy)
BUSINESS_NAME=LeadAgent Demo
BUSINESS_INDUSTRY=general
# Comma-separated owner WhatsApp numbers (digits only, no +). Empty = allow any sender.
BUSINESS_OWNER_PHONES=917073245149

# Admin dashboard — https://your-app.onrender.com/admin
ADMIN_DASHBOARD_PASSWORD=change-me
# Production: use bcrypt hash from `python scripts/hash_admin_password.py`
ADMIN_SESSION_SECRET=generate-a-long-random-string
# Optional: comma-separated IPs allowed to access /admin (empty = all)
ADMIN_IP_ALLOWLIST=

# Lead capture webhook — POST /api/leads with header X-Lead-Webhook-Secret
LEAD_WEBHOOK_SECRET=

# Google Sheets backup — Apps Script web app URL (see docs/CLIENT_SETUP.md)
GOOGLE_SHEETS_WEBHOOK_URL=

# WhatsApp alert to owners when POST /api/leads captures a lead
NOTIFY_OWNERS_ON_WEBHOOK=true

# Optional Sentry error monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Daily summary cron — POST with header X-Cron-Secret, or GET with ?secret=
# Verify: GET /health should return "cron_configured": true
CRON_SECRET=
STALE_LEAD_DAYS=2
